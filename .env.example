DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Set to 1 only when this app sits behind a TLS-terminating proxy/load
# balancer (real production) — enables HSTS, SSL redirect, and secure
# cookies. Leave at 0 for local docker-compose, which talks plain HTTP.
DJANGO_ENFORCE_HTTPS=0

POSTGRES_DB=artikate
POSTGRES_USER=artikate
POSTGRES_PASSWORD=artikate
POSTGRES_HOST=db
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
